# Maintainer: Meik Augenblick <meik.augenblick@googlemail.com>
pkgname=random-filesplitter
pkgver=3.0.0
pkgrel=1
pkgdesc="High-performance cryptographic file splitter & reconstructor (Post-Quantum & Plausible Deniability)"
arch=('x86_64' 'aarch64')
url="https://github.com/Meik1982/random-filesplitter"
license=('LGPL-3.0-or-later')
depends=('gcc-libs')
makedepends=('cargo' 'git')
provides=('rfs')
conflicts=('rfs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/rfs "$pkgdir/usr/bin/rfs"
    install -Dm644 docs/rfs.1 "$pkgdir/usr/share/man/man1/rfs.1"
    install -Dm644 completions/rfs.bash "$pkgdir/usr/share/bash-completion/completions/rfs"
    install -Dm644 completions/_rfs "$pkgdir/usr/share/zsh/site-functions/_rfs"
    install -Dm644 completions/rfs.fish "$pkgdir/usr/share/fish/vendor_completions.d/rfs.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

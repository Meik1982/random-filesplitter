#compdef rfs

# Zsh completion for rfs (random-filesplitter v3.1.0)

_rfs() {
    local context state state_descr line
    typeset -A opt_args

    local -a common_opts
    common_opts=(
        '(-h --help)'{-h,--help}'[Display help message]'
        '(-V --version)'{-V,--version}'[Display version information]'
        '(-f --force)'{-f,--force}'[Overwrite existing destination files]'
        '(-q --quiet --silent)'{-q,--quiet,--silent}'[Suppress interactive progress (errors only)]'
        '(-l --lang)'{-l,--lang}'[Select output language]:language:(en de es fr ja zh tok sp)'
        '--json[Machine-readable NDJSON telemetry on stderr]'
        '--direct[Direct I/O: Bypass OS page cache]'
        '--mlock[Lock buffer memory in physical RAM (swap resilience)]'
        '(--token --rnd)'{--token,--rnd}'[Anti-forensics: Uncorrelated hex tokens (.<rnd>.rfs)]'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args' && return 0

    case $state in
        command)
            local -a subcommands
            subcommands=(
                'split:Datei in N Rausch-Teile aufteilen'
                'restore:Originaldatei aus N Teilen bitgenau wiederherstellen'
                'verify:Integrität und Prüfsummen im RAM verifizieren'
                'decoy:Ununterscheidbare Köderdateien (Decoys) erzeugen'
                'scan:Kombinatorischer Scan zur Auto-Erkennung von N-Way Shares'
                'forge:Gefälschte Gegen-Share zur Rubber-Hose-Abwehr synthetisieren'
                'benchmark:Hardware-Durchsatzmessung (SIMD, CSPRNG, BLKS)'
                'entropy:Zweiphasige Hardware- und CSPRNG-Entropiediagnose'
                'analyze:NIST SP 800-22 Datei-Entropieanalyse'
            )
            _describe -t subcommands 'Subcommands' subcommands
            _arguments $common_opts \
                '(-b --benchmark)'{-b,--benchmark}'[Hardware-Benchmark ausführen]' \
                '(-e --entropy --entropy-test)'{-e,--entropy,--entropy-test}'[Entropiediagnose ausführen]' \
                '(-a --analyze)'{-a,--analyze}'[Datei analysieren]:Datei:_files' \
                '(-v --verify --check)'{-v,--verify,--check}'[Integrität prüfen]'
            ;;
        args)
            case $words[1] in
                split)
                    _arguments \
                        $common_opts \
                        '(-n --parts)'{-n,--parts}'[Number of shares (2..64)]:count:(2 3 4 5 8 16)' \
                        '(-T --threshold)'{-T,--threshold}'[Threshold T for symmetric multi-payload splitting]:threshold:(2 3 4 5 8)' \
                        '(-d --decoys)'{-d,--decoys}'[Number of additional decoy chaff files]:count:(1 2 3 4 5)' \
                        '--decoy-reveal[Embed authentic plaintext decoy into shares]:decoy file:_files' \
                        '--pad-to[Pad shares to exact target byte size]:size:(64K 1M 10M 100M 1G 10G)' \
                        '(-B --block-size)'{-B,--block-size}'[I/O buffer block size]:size:(64K 256K 1M 4M 8M 16M)' \
                        '(-o --output)'{-o,--output}'[Output prefix or directory]:path:_files' \
                        '*:Input and output files:_files'
                    ;;
                decoy)
                    _arguments \
                        $common_opts \
                        '(-c --count)'{-c,--count}'[Anzahl der Köderdateien]:Anzahl:(1 2 3 4 5 10)' \
                        '(-s --size)'{-s,--size}'[Explizite Dateigröße]:Größe:(64K 1M 10M 100M 1G)' \
                        '(-t --template)'{-t,--template}'[Musterdatei (Rohdatei +60B oder RFS 1:1)]:Musterdatei:_files' \
                        '(-B --block-size)'{-B,--block-size}'[Puffergröße]:Größe:(64K 256K 1M 4M 8M 16M)' \
                        '(-o --output)'{-o,--output}'[Präfix oder Dateipfad]:Datei:_files' \
                        '*:Optionale Musterdatei:_files'
                    ;;
                scan)
                    _arguments \
                        $common_opts \
                        '(-r --restore)'{-r,--restore}'[Gefundene Payloads direkt wiederherstellen]' \
                        '(-o --output)'{-o,--output}'[Ausgabe-Zielverzeichnis]:Verzeichnis:_files -/' \
                        '*:Kandidaten-Dateien:_files'
                    ;;
                forge)
                    _arguments \
                        $common_opts \
                        '--reveal-as[Vorzulegende Köder-Klartextdatei]:Köderdatei:_files' \
                        '(-o --output)'{-o,--output}'[Ausgabepfad der gefälschten Gegen-Share]:Datei:_files' \
                        '(-B --block-size)'{-B,--block-size}'[Puffergröße]:Größe:(64K 256K 1M 4M 8M 16M)' \
                        '*:Bestehende Share-Dateien:_files'
                    ;;
                restore)
                    _arguments \
                        $common_opts \
                        '(-B --block-size)'{-B,--block-size}'[Puffergröße]:Größe:(64K 256K 1M 4M 8M 16M)' \
                        '(-o --output)'{-o,--output}'[Zieldatei (oder - für stdout)]:Datei:_files' \
                        '*:Split-Dateien:_files'
                    ;;
                verify)
                    _arguments \
                        $common_opts \
                        '(-B --block-size)'{-B,--block-size}'[Puffergröße]:Größe:(64K 256K 1M 4M 8M 16M)' \
                        '*:Split-Dateien:_files'
                    ;;
                analyze)
                    _arguments \
                        $common_opts \
                        '1:Zu analysierende Datei:_files'
                    ;;
            esac
            ;;
    esac
}

_rfs "$@"
